# Allow project roots only. MAME source, FBNeo, and other installations stay local.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/PuyoPuyo2/
!/mame-bin/
!/puyo2-lan-runs/
!/puyo2-link/

# The runtime lives inside MAME, but only our plugin and link evidence belong in Git.
/mame-bin/*
!/mame-bin/plugins/
!/mame-bin/puyo2-lan-runs/
!/mame-bin/puyo2-link/
!/mame-bin/puyo2-session-*/
/mame-bin/plugins/*
!/mame-bin/plugins/puyo2link/

# Extracted ROM sets; do not exclude game-named NVRAM directories.
/PuyoPuyo2/puyopuy2/
/PuyoPuyo2/puyopuy2_patched/
roms/

# ROM/media images and archives, including copies in historical checkpoints.
*.[zZ][iI][pP]
*.7[zZ]
*.[rR][aA][rR]
*.[tT][aA][rR]
*.[gG][zZ]
*.[bB][zZ]2
*.[xX][zZ]
*.[zZ][sS][tT]
*.[rR][oO][mM]
*.[cC][hH][dD]
*.[iI][sS][oO]
*.[iI][mM][gG]
*.[cC][uU][eE]
*.[iI][cC][0-9]*
*.[uU][0-9]*
*.[bB][iI][nN]

# Named link traffic and work-RAM captures are not ROM images.
!A_to_B.bin
!B_to_A.bin
!ram_[aAbB]_*.bin
!latejoin_[aAbB]_*.bin

# Compiled programs/libraries and development caches are not project artifacts.
*.[eE][xX][eE]
*.[dD][lL][lL]
*.so
*.so.*
*.dylib
*.o
*.obj
*.a
*.lib
*.pdb
*.sym
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.puyo2-lan-test-*/
.DS_Store
Thumbs.db

# Keep project logs, screenshots, journals, flow-control snapshots,
# configuration, hardware plans, and research/checkpoint files.
